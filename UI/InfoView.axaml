<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="nanoMIDIPlayer.UI.InfoView"
             FontFamily="{StaticResource MonoFont}">
    <Border Background="{StaticResource MidiBack}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Image Source="/Assets/banner.png" Width="140" Height="42"
                       HorizontalAlignment="Left" Margin="0,4,0,12"/>
                <TextBlock x:Name="PlatformLine" Foreground="#737373" Margin="0,0,0,16"/>
                <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="White"
                           Text="Spielt MIDI-Dateien ab, indem Noten in Tastendrücke übersetzt werden — für virtuelle Pianos (z.B. Roblox)."/>
                <TextBlock Text="Hotkeys:" FontWeight="Bold" Margin="0,16,0,0"/>
                <TextBlock Text="F1 Play · F2 Pause · F3 Stop · F4 Speed+ · F5 Speed-" Margin="0,2,0,0"/>
                <TextBlock Text="Config:" FontWeight="Bold" Margin="0,16,0,0"/>
                <TextBlock x:Name="ConfigLine" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <TextBlock Text="Kompatibel mit der Config des Python-Originals." Margin="0,2,0,0"/>
                <TextBlock x:Name="PermissionBlock" TextWrapping="Wrap" LineHeight="20"
                           Foreground="#d0a000" Margin="0,16,0,0" IsVisible="False"/>

                <TextBlock Text="Updates:" FontWeight="Bold" Margin="0,16,0,0"/>
                <TextBlock x:Name="UpdateStatusLine" Foreground="#a0a0a0" Margin="0,4,0,0"/>
                <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="1" Height="6"
                             Margin="0,10,0,0" IsVisible="False"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Spacing="10">
                    <Button x:Name="CheckUpdateButton" Content="auf updates prüfen"
                            Theme="{StaticResource CtkButton}" Width="170" Height="28"
                            Click="OnCheckUpdate"/>
                    <Button x:Name="InstallUpdateButton" Content="jetzt installieren"
                            Theme="{StaticResource CtkButton}" Width="170" Height="28"
                            Click="OnInstallUpdate" IsVisible="False"/>
                </StackPanel>
                <CheckBox x:Name="AutoCheckBox" Content="beim start automatisch prüfen"
                          Margin="0,14,0,0" IsCheckedChanged="OnUpdaterOptionChanged"/>
                <CheckBox x:Name="AutoInstallBox" Content="updates automatisch installieren"
                          Margin="0,8,0,0" IsCheckedChanged="OnUpdaterOptionChanged"/>
                <CheckBox x:Name="PrereleaseBox" Content="auch pre-releases berücksichtigen"
                          Margin="0,8,0,0" IsCheckedChanged="OnUpdaterOptionChanged"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
